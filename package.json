{
  "name": "webshaped-blog-frontend",
  "version": "1.15.2",
  "description": "My personal blog",
  "homepage": "https://webshaped.de",
  "bugs": {
    "url": "https://github.com/felix-berlin/webshaped-blog-astro/issues"
  },
  "author": {
    "name": "Felix Scholze",
    "email": "felix@webshaped.de",
    "url": "https://webshaped.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felix-berlin/webshaped-blog-astro"
  },
  "funding": [
    {
      "type": "GitHub Sponsors",
      "url": "https://github.com/sponsors/felix-berlin"
    },
    {
      "type": "Ko-fi",
      "url": "https://ko-fi.com/felixberlin"
    },
    {
      "type": "PayPal",
      "url": "https://paypal.me/FelixScholze"
    },
    {
      "type": "Buy me a coffee",
      "url": "https://www.buymeacoffee.com/felixberlin"
    }
  ],
  "type": "module",
  "scripts": {
    "dev": "infisical run -- astro dev",
    "agent": "infisical secrets agent-proxy run -e dev --set-env WP_AUTH_USER=x --set-env WP_AUTH_PASS=x --set-env IMAGOR_SECRET=x -- claude",
    "start": "astro dev",
    "build": "astro build",
    "build:local": "infisical run -- pnpm run build",
    "docker:local": "infisical run --env=dev -- bash -c 'scripts/write-build-env.sh .build.env quoted && docker compose -f compose.yaml -f compose.local.yaml up --build; rm -f .build.env'",
    "build:server": "export $(cat .env) && astro build",
    "build:strict": "astro check && tsc --noEmit && vue-tsc --noEmit && astro build",
    "preview": "export $(cat .env) && astro preview",
    "astro": "astro",
    "typechecking": "astro check && vue-tsc --noEmit",
    "lint:js": "pnpm run lint:js:oxlint",
    "lint:js:oxlint": "oxlint src/ --deny-warnings --fix --fix-suggestions",
    "lint:style": "stylelint \"**/*.{scss,sass}\" --ignore-path .gitignore",
    "lint": "pnpm run lint:js && pnpm run lint:style",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:update": "vitest --update",
    "test:unit:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
    "test:e2e": "pnpx playwright test",
    "test:e2e:ui": "pnpx playwright test --ui",
    "format": "pnpm exec oxfmt .",
    "format:check": "pnpm exec oxfmt --check .",
    "gql:generate": "infisical run -- graphql-codegen --config codegen.ts",
    "gql:generate:watch": "infisical run -- graphql-codegen --config codegen.ts --watch",
    "preinstall": "pnpx only-allow pnpm",
    "copy:pagefind": "pnpm dlx shx cp -r dist/pagefind public/",
    "predev": "pnpm run gql:generate"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vue": "^7.0.3",
    "@felix_berlin/sass-butler": "^4.0.0",
    "@fontsource/source-sans-pro": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/tabler": "^1.2.41",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/vue": "^1.1.0",
    "@pagefind/default-ui": "^1.5.2",
    "@sentry/astro": "^11.1.0",
    "@spotlightjs/astro": "^3.2.6",
    "@urql/core": "^6.0.3",
    "@urql/exchange-graphcache": "^9.0.1",
    "@urql/vue": "^2.1.1",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.3.5",
    "astro-breadcrumbs": "^3.4.2",
    "astro-loading-indicator": "^0.9.0",
    "astro-matomo": "^1.12.0",
    "floating-vue": "5.4.0",
    "he": "^1.2.0",
    "nanostores": "^1.5.4",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tm-themes": "^1.12.12",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@astrojs/check": "^0.9.10",
    "@codecov/astro-plugin": "^2.0.1",
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-codegen/introspection": "^6.1.0",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@infisical/cli": "^0.43.138",
    "@nanostores/logger": "^1.1.0",
    "@playform/inline": "0.1.4",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@shikijs/transformers": "^4.5.0",
    "@types/he": "^1.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/web-worker": "^5.0.3",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "graphql": "^16.14.2",
    "graphql-config": "^5.1.7",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.5.5",
    "postcss-scss": "^4.0.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.1",
    "semantic-release": "^25.0.9",
    "sirv": "^3.0.2",
    "std-env": "^4.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.2",
    "vite-plugin-graphql-loader": "^5.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.10.1"
}
