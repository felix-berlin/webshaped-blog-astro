# Test-only values, loaded when VARLOCK_ENV=test (see the test:unit script).
#
# Committed on purpose and safe to read: every value here is fake. Its job is to
# satisfy .env.schema so `getViteConfig()` can load astro.config.mjs without
# reaching Infisical — unit tests must not need real credentials.
#
# Every item whose schema value is `infisical()` needs an entry, otherwise the
# resolver runs and fails on missing auth.

WP_API=https://cms.webshaped.test/graphql
WP_REST_API=https://cms.webshaped.test/wp-json
WP_AUTH_USER=test-user
WP_AUTH_PASS=test pass word
LAST_FM_SCROBBLER_API=https://last-fm.webshaped.test
SITE_URL=https://webshaped.test
GITHUB_TOKEN=ghp_testtoken
SENTRY_DSN=https://testkey@o0.ingest.test.sentry.io/0
SENTRY_PROJECT_ID=webshaped-blog-test
SENTRY_ENVIRONMENT=test
SENTRY_AUTH_TOKEN=sntrys_test
CODECOV_TOKEN=codecov-test
