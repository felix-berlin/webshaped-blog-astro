{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)",
    "group:monorepos",
    "group:recommended"
  ],
  "reviewers": ["felix-berlin"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am every weekday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "schedule": ["at any time"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Only patch/digest/pin updates automerge; minor/major stay PRs for review",
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "minimumReleaseAge": "2 days"
    },
    {
      "groupName": "astro",
      "matchPackageNames": ["astro", "@astrojs/**", "astro-*"]
    },
    {
      "groupName": "vue",
      "matchPackageNames": ["vue", "@vue/**", "@vueuse/**", "nanostores", "@nanostores/**"]
    },
    {
      "groupName": "sentry",
      "matchPackageNames": ["@sentry/**"]
    },
    {
      "groupName": "test tooling",
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "jsdom",
        "@vue/test-utils",
        "@playwright/**",
        "msw",
        "@faker-js/faker"
      ]
    },
    {
      "groupName": "lint and format",
      "matchPackageNames": [
        "oxlint",
        "oxfmt",
        "stylelint",
        "stylelint-*",
        "eslint-plugin-*",
        "typescript",
        "vue-tsc"
      ]
    },
    {
      "groupName": "icons",
      "matchPackageNames": ["@iconify-json/**", "unplugin-icons"]
    },
    {
      "groupName": "type definitions",
      "matchPackageNames": ["@types/**"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "docker base images",
      "matchDatasources": ["docker"]
    },
    {
      "description": "Node major follows the image/CI, bumped by hand",
      "matchPackageNames": ["node", "node-slim", "gcr.io/distroless/nodejs*"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
