---
import "@styles/app.scss";
import "@fontsource/source-sans-pro/400.css";
import "@fontsource/source-sans-pro/400-italic.css";
import "@fontsource/source-sans-pro/700.css";

import type { Seo } from "@components/BaseHead.astro";

import BaseHead from "@components/BaseHead.astro";
import MainFooter from "@components/footer/MainFooter.astro";
import MainHeader from "@components/hero/MainHeader.astro";
import { defaultLang } from "@utils/i18n/ui";

import type { TranslationRoutes } from "@/types/i18n";

export interface DefaultLayoutProps {
  bodyClasses?: Array<string> | string;
  content: {
    // language isn't consumed here — each page passes its own query's shape.
    language: unknown;
    seo: Seo;
    title: string;
  };
  contentClasses?: Array<string> | string;
  translationsRoutes?: TranslationRoutes;
}

const {
  bodyClasses,
  content: { seo, title },
  contentClasses,
  translationsRoutes,
} = Astro.props as DefaultLayoutProps;

const lang = (Astro.currentLocale ?? defaultLang) as "de" | "en";
---

<!-- TODO: Remove after lightmode is final: #9 -->
<html class="dark" lang={lang}>
  <!-- <Head> -->
  <BaseHead lang={lang} seo={seo} title={title} translationsRoutes={translationsRoutes ?? {}}>
    <Fragment slot="head">
      <slot name="head" />
    </Fragment>
  </BaseHead>

  <body class="o-body" class:list={bodyClasses}>
    <MainHeader lang={lang} translationsRoutes={translationsRoutes ?? {}} />
    <main class="o-content" class:list={contentClasses}>
      <slot />
    </main>

    <MainFooter lang={lang} />
  </body>
</html>
