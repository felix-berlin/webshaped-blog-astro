---
import type { Lang } from "@i18n/ui";
import "@styles/components/_author.scss";
import "@styles/components/_details.scss";
import ScrobbleDisplay from "@components/ScrobbleDisplay.vue";
import SocialList from "@components/SocialList.vue";
import { getAuthorSocialItems } from "@utils/helpers";
import { useTranslations } from "@utils/i18n/utils";
import { LAST_FM_SCROBBLER_API, SITE_URL } from "astro:env/client";

import type { GetAllPostsQuery } from "@/gql/graphql.ts";

export interface Props {
  author: NodeWithAuthorToUserConnectionEdge | undefined;
  lang: Lang;
}

type NodeWithAuthorToUserConnectionEdge = NonNullable<
  GetAllPostsQuery["posts"]
>["nodes"][number]["author"];

const { author, lang } = Astro.props;
const t = useTranslations(lang);
const authorName = `${author?.node.firstName ?? ""} ${author?.node.lastName ?? ""}`.trim();
---

<div
  class="c-author u-glas-background u-rounded"
  itemid={`${SITE_URL}/#person`}
  itemscope
  itemtype="http://schema.org/Person"
>
  <div class="c-author__image-wrap">
    {
      author?.node?.avatar?.url && (
        <img
          alt={t("comment.author.image.alt", { author: authorName })}
          class="c-author__image"
          height={author.node.avatar.height}
          itemprop="image"
          loading="eager"
          src={author.node.avatar.url}
          width={author.node.avatar.width}
        />
      )
    }

    <ScrobbleDisplay
      client:only="vue"
      dropdownPlacement="left"
      idle-after-count={1}
      lang={lang}
      scrobbleApi={LAST_FM_SCROBBLER_API}
    />
  </div>

  <p class="c-author__name" itemprop="name">
    {authorName}
  </p>

  <p class="c-author__description" itemprop="description">
    {author?.node.description}
  </p>

  <details class="c-author__details-toggle c-details">
    <summary><span class="c-details__title">{t("more")}</span></summary>
    <SocialList
      lang={lang}
      socialItems={getAuthorSocialItems(author?.node, 20)}
    />
  </details>
</div>
