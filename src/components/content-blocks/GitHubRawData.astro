---
import { Code } from "astro/components";
import materialThemeLighter from "tm-themes/themes/material-theme-lighter.json";
import materialThemePalenight from "tm-themes/themes/material-theme-palenight.json";

import type { AcfGithubRawDataFragment } from "@/gql/graphql.ts";

interface GitHubRawDataProps {
  block: AcfGithubRawDataFragment;
}

const { block } = Astro.props as GitHubRawDataProps;

const { codeLanguage, githubRawUrl } = block.githubRawData ?? {};

async function getContent() {
  if (!githubRawUrl) return "";

  const response = await fetch(githubRawUrl);
  const content = await response.text();
  return content;
}

const content = await getContent();
---

<div class="c-blocks__code">
  <Code
    code={content}
    lang={
      /* astro/shiki's CodeLanguage union isn't publicly exported; CMS supplies an arbitrary string */
      (codeLanguage ?? undefined) as unknown as Exclude<Parameters<typeof Code>[0], undefined>["lang"]
    }
    themes={{
      dark: { ...materialThemePalenight, type: materialThemePalenight.type as "dark" },
      light: { ...materialThemeLighter, type: materialThemeLighter.type as "light" },
    }}
    wrap
  />
</div>
