---
import CodeBlock from "@components/content-blocks/CodeBlock.astro";
import { fetchRawText } from "@utils/fetchRawText";

import type { AcfGithubRawDataFragment } from "@/gql/graphql.ts";

interface Props {
  block: AcfGithubRawDataFragment;
}

const { block } = Astro.props;

const { codeLanguage, githubRawUrl } = block.githubRawData ?? {};
const content = githubRawUrl ? await fetchRawText(githubRawUrl) : "";
---

<CodeBlock code={content} lang={codeLanguage} />
