---
import CodeBlock from "@components/content-blocks/CodeBlock.astro";
import { parse } from "@utils/helpers";

import type { AcfCodeHighlightingFragment } from "@/gql/graphql.ts";

interface Props {
  block: AcfCodeHighlightingFragment;
}

const { block } = Astro.props;

const { code, custom_language, language, use_custom_language } = parse(block.attributes?.data as string | undefined) ?? {};
---

<CodeBlock code={code} lang={use_custom_language ? custom_language : language} />
