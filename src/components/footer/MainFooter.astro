---
import type { Lang } from "@i18n/ui";
import GreenHosted from "@components/footer/GreenHosted.vue";
import Menu from "@components/Menu.vue";
import SocialList from "@components/SocialList.vue";
import { getAuthorSocialItems } from "@utils/authorSocials";
import { mapMenuPaths } from "@utils/helpers";
import { categoryPathBuilder, toLanguageCode, useTranslations } from "@utils/i18n/utils";
import { wpQueryChrome } from "@services/wpGraphqlClient";
import Copyright from "~icons/lucide/copyright";
import GitCommit from "~icons/lucide/git-commit";

import {
  GetAllCategoriesDocument,
  GetMenuItemsDocument,
  type GetAuthorQuery,
} from "@/gql/graphql.ts";
import { useFragment } from "@/gql";
import { CategoryFields } from "@services/queries/getCategory";

import { version } from "../../../package.json";

interface Props {
  author: GetAuthorQuery["user"] | null | undefined;
  lang: Lang;
}

const { author, lang } = Astro.props;

const [categoriesResponse, footerMenuItemsResponse] = await Promise.all([
  wpQueryChrome(GetAllCategoriesDocument, { languages: [toLanguageCode(lang)] }),
  wpQueryChrome(GetMenuItemsDocument, {
    language: toLanguageCode(lang),
    location: "SECONDARY_MENU",
  }),
]);

const categories = categoriesResponse?.categories;

// WP menu paths (e.g. "/impressum") don't know about the [lang]-prefixed
// routing scheme (src/pages/[lang]/[pageSlug].astro) — prefix them here.
const footerMenuItems = mapMenuPaths(footerMenuItemsResponse?.menuItems, (path) => `/${lang}${path}`);

const t = useTranslations(lang);
---

<footer class="o-footer">
  <SocialList
    class:list={["o-footer__social-list", "is-footer"]}
    lang={lang}
    socialItems={getAuthorSocialItems(author, 40)}
  />

  <div class="o-footer__end">
    <div class="o-footer__logo">
      <img
        alt="Web Shaped Logo"
        decoding="async"
        height="103"
        loading="lazy"
        src="/assets/logo/web_shaped_logo_2023_whail_trans_white_outline_no-spacing.svg"
        width="150"
      />
    </div>

    <div class="o-footer__categories">
      <h3 class="o-footer__headline">
        {t("categories")}
      </h3>
      <menu class="c-menu c-menu--footer-two-columns u-list-reset">
        {
          categories &&
            categories.nodes
              .map((category) => useFragment(CategoryFields, category))
              .map((category) => (
                <li class="c-menu__item">
                  <a
                    class="c-menu__link"
                    href={categoryPathBuilder(category.slug ?? "", category.language?.slug ?? lang)}
                  >
                    {category.name}
                  </a>
                </li>
              ))
        }
      </menu>
    </div>
    <div class="o-footer__other">
      <h3 class="o-footer__headline">
        {t("footer.headline.other")}
      </h3>
      <Menu class:list={"o-footer__menu c-menu--footer"} menuItems={footerMenuItems ?? { nodes: [] }} />
    </div>
    <div class="o-footer__quote">
      <figure>
        <blockquote>
          „If debugging is the process of removing software bugs, then programming must be the
          process of putting them in.“
        </blockquote>
        <figcaption>
          —Edsger W. Dijkstra, <cite>(1930 – 2002)</cite>
        </figcaption>
      </figure>
    </div>
    <div class="o-footer__infos">
      <div class="o-footer__credits">
        <Copyright height="16" width="16" />
        <span>
          2015 - {t("footer.copyright.now")} Felix Scholze
        </span>
      </div>
      <a
        class="o-footer__version"
        href="https://github.com/felix-berlin/webshaped-blog-astro/releases"
        target="_blank"
        title="Github Releases Seite"
      >
        <GitCommit height="16" width="16" />
        <span>Website Version: {version}</span>
      </a>

      <GreenHosted lang={lang} />
    </div>
  </div>
</footer>
