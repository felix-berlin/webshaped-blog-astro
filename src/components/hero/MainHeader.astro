---
import type { Lang } from "@i18n/ui";
import "@styles/objects/_header.scss";
import MainNav from "@components/hero/MainNav.vue";
import { MENU_ID_BY_LANG, updateCategoryPaths } from "@utils/helpers";
import { wpQueryChrome } from "@services/wpGraphqlClient";

import { GetMenuByIdDocument } from "@/gql/graphql.ts";
import type { TranslationRoutes } from "@/types/i18n";

interface Props {
  lang: Lang;
  translationsRoutes: TranslationRoutes;
}

const { lang, translationsRoutes } = Astro.props;

const mainMenuItems = await wpQueryChrome(GetMenuByIdDocument, { id: MENU_ID_BY_LANG[lang] });

const menuItems = updateCategoryPaths(mainMenuItems?.menu?.menuItems ?? null, lang);
---

<header class="o-header" id="mainHeader">
  <MainNav client:only="vue" menuItems={menuItems} lang={lang} translationsRoutes={translationsRoutes} />
</header>
