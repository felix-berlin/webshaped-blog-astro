---
import '@styles/objects/_category.scss';
import '@styles/objects/_blog-listing.scss';
import '@styles/components/_blog-posts.scss';
import type { GetStaticPaths, InferGetStaticParamsType, PaginateFunction } from 'astro';

import BlogPostPreview from '@components/BlogPostPreview.vue';
import type { BlogPostPreviewProps } from '@components/BlogPostPreview.vue';
import Pagination from '@components/Pagination.vue';
import DefaultLayout from '@layouts/DefaultLayout.astro';
import type { Lang } from '@i18n/ui';
import { removeLocaleCode } from '@utils/helpers';
import { buildTranslationRoutes, categoryPathBuilder, isLang } from '@utils/i18n/utils';
import { CATEGORY_PAGE_SIZE } from '@utils/routes';
import { wpQuery } from '@services/wpGraphqlClient';

import { GetAllPostPreviewsByCategoryDocument } from '@/gql/graphql.ts';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }: { paginate: PaginateFunction }) => {
  const postsResponse = await wpQuery(GetAllPostPreviewsByCategoryDocument, {});

  // WPGraphQL links category translations bidirectionally: both the German
  // original and its English counterpart appear as their own top-level node
  // AND in each other's `translations`. Without deduping by the (lang, slug)
  // the URL actually uses, every cross-language pair got built twice, which
  // Astro's build rejects as a route conflict.
  const seenRoutes = new Set<string>();

  return (postsResponse.categories?.nodes ?? []).flatMap((category) => {
    if (!category.posts?.nodes.length) return [];

    // The category itself plus each translation that has posts. Translations
    // don't carry their own seo data in this query, so all share the parent's.
    const variants = [category, ...(category.translations ?? [])].flatMap((variant) => {
      const lang = variant?.language?.slug;
      const posts = variant?.posts?.nodes ?? [];
      const slug = removeLocaleCode(variant?.slug ?? null);
      return isLang(lang) && slug && posts.length ? [{ lang, posts, slug, title: variant?.name }] : [];
    });
    const availableLanguages: Lang[] = variants.map(({ lang }) => lang);

    return variants.flatMap(({ lang, posts, slug, title }) => {
      const routeKey = `${lang}:${slug}`;
      if (seenRoutes.has(routeKey)) return [];
      seenRoutes.add(routeKey);

      return paginate(posts, {
        pageSize: CATEGORY_PAGE_SIZE,
        params: { lang, slug },
        props: { availableLanguages, content: { seo: category.seo, title } },
      });
    });
  });
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;

const { availableLanguages, content, page } = Astro.props;
const { lang, slug } = Astro.params as Params;

// TODO: make slug the same as in german — translations currently reuse this page's slug.
const translationsRoutes = buildTranslationRoutes(
  availableLanguages.map((language) => [
    language,
    categoryPathBuilder(slug, language, String(page.currentPage)),
  ]),
);
---

<DefaultLayout content={content} contentClasses='o-category' translationsRoutes={translationsRoutes}>
  <header class='o-category__header'>
    <h1 class='o-category__headline'>{content.title}</h1>
  </header>
  <section class='c-blog-posts'>
    <BlogPostPreview lang={lang} posts={page.data as unknown as BlogPostPreviewProps['posts']} />
  </section>
  <Pagination lang={lang} page={page} slug={slug} />
</DefaultLayout>
