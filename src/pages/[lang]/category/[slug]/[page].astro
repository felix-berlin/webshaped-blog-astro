---
import '@styles/objects/_category.scss';
import '@styles/objects/_blog-listing.scss';
import '@styles/components/_blog-posts.scss';
import type {
  GetStaticPaths,
  InferGetStaticParamsType,
  InferGetStaticPropsType,
  PaginateFunction,
} from 'astro';

import BlogPostPreview from '@components/BlogPostPreview.vue';
import type { BlogPostPreviewProps } from '@components/BlogPostPreview.vue';
import Pagination from '@components/Pagination.vue';
import DefaultLayout from '@layouts/DefaultLayout.astro';
import { removeLocaleCode } from '@utils/helpers';
import { wpQuery } from '@services/wpGraphqlClient';

import type { LanguageCodeEnum } from '@/gql/graphql.ts';
import { GetAllPostPreviewsByCategoryDocument } from '@/gql/graphql.ts';
import type { TranslationRoutes } from '@/types/i18n';

export const prerender = true;

interface Paginate {
  paginate: PaginateFunction;
}

export const getStaticPaths = (async ({ paginate }: Paginate) => {
  const postsResponse = await wpQuery(GetAllPostPreviewsByCategoryDocument, {});
  const postPreviews = postsResponse.categories;
  const pageCount = 6;

  /**
   * @see https://docs.astro.build/en/core-concepts/routing/#nested-pagination
   */
  if (!Array.isArray(postPreviews?.nodes)) {
    return [];
  }

  return postPreviews.nodes.flatMap((category) => {
    const { seo } = category;
    const categoriesDe = category.posts?.nodes;
    const categoriesEn = category.translations;

    const availableLanguages: string[] = [];

    const hasDeCategories = Array.isArray(categoriesDe) && categoriesDe.length;

    if (hasDeCategories && category.language?.slug) {
      availableLanguages.push(category.language.slug);
    }

    if (!hasDeCategories) return [];

    const germanPaths = paginate(categoriesDe, {
      pageSize: pageCount,
      params: {
        lang: category.language?.slug as string,
        slug: category.slug as string,
      },
      props: {
        availableLanguages: availableLanguages,
        content: {
          language: category.language,
          seo,
          title: category.name,
        },
      },
    });

    // TODO: make slug the same as in german
    const englishPaths =
      categoriesEn?.flatMap((translation) => {
        // Translations don't carry their own seo data in this query; fall back to the parent category's.
        const categoriesEnPosts = translation?.posts?.nodes;

        const hasEnCategories = Array.isArray(categoriesEnPosts) && categoriesEnPosts.length;

        if (hasEnCategories && translation?.language?.slug) {
          availableLanguages.push(translation.language.slug);
        }

        if (!hasEnCategories) return [];

        return paginate(categoriesEnPosts, {
          pageSize: pageCount,
          params: {
            lang: translation?.language?.slug as string,
            slug: removeLocaleCode(translation?.slug ?? null),
          },
          props: {
            availableLanguages: availableLanguages,
            content: {
              language: translation?.language,
              seo,
              title: translation?.name,
            },
          },
        });
      }) ?? [];

    return [...germanPaths, ...englishPaths];
  });
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { availableLanguages, content, page } = Astro.props;
const { lang, slug } = Astro.params as Params;

const path = `${lang}/category/${slug}`;
const posts = page.data;

const translationsRoutes = availableLanguages.reduce<TranslationRoutes>((acc, language) => {
  acc[language as 'de' | 'en'] = `/${language}/category/${slug}/${page.currentPage}`;
  return acc;
}, {});
---

<DefaultLayout content={content} contentClasses='o-category' translationsRoutes={translationsRoutes}>
  <header class='o-category__header'>
    <h1 class='o-category__headline'>{content.title}</h1>
  </header>
  <section class='c-blog-posts'>
    <BlogPostPreview posts={posts as unknown as BlogPostPreviewProps['posts']} />
  </section>
  <Pagination
    lang={
      content.language as unknown as
        | ({ code: LanguageCodeEnum | null; locale: string | null; slug: string | null } & string)
        | null
    }
    page={page}
    path={path}
  />
</DefaultLayout>
