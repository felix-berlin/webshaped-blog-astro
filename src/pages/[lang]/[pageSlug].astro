---
import GithubStats from "@components/GithubStats.vue";
import DefaultLayout from "@layouts/DefaultLayout.astro";
import { wpQuery } from "@services/wpGraphqlClient";
import { buildTranslationRoutes, getLang, pagePathBuilder, useTranslations } from "@utils/i18n/utils";
import { ABOUT_PAGE_SLUG, STATIC_PAGE_SLUGS } from "@utils/routes";
import "@styles/components/_post-card.scss";
import "@styles/objects/_developer-card.scss";
import { Image } from "astro:assets";

import { GetPagesBySlugsDocument } from "@/gql/graphql.ts";
import { pageVariants } from "@services/queries/getPage";

// The about page (ABOUT_PAGE_SLUG) gets the special developer-card layout
// with live GitHub stats instead of generic WP page content — see
// isAboutPage below. Merged into this catch-all route because Astro's
// route priority (dynamic single-segment beats rest params) means a
// separate [...about].astro under the same [lang]/ parent would never be
// reached: [pageSlug] always wins the match first.
const pagesResponse = await wpQuery(GetPagesBySlugsDocument, { slugs: STATIC_PAGE_SLUGS });

const { pageSlug } = Astro.params;
const lang = getLang(Astro.currentLocale);

const allPages = (pagesResponse.pages?.nodes ?? []).flatMap((node) => {
  const variants = pageVariants(node);
  // Tag every variant with the German slug we queried by, so we can tell
  // which WP page group a match belongs to regardless of which language's
  // slug the URL actually matched.
  return variants.map((variant) => ({ ...variant, canonicalSlug: variants[0].slug }));
});

const page = allPages.find(
  (candidate) => candidate.slug === pageSlug && candidate.language?.slug === lang,
);

if (!page) return Astro.rewrite("/404");

// Scoped to this page's own group (matched by canonicalSlug) — allPages
// contains every fetched page's translations combined, and reducing over
// all of them unscoped would let the last-processed page's language links
// silently overwrite this page's own.
const translationsRoutes = buildTranslationRoutes(
  allPages
    .filter((candidate) => candidate.canonicalSlug === page.canonicalSlug)
    .map(({ language, slug }) => [language?.slug, slug && pagePathBuilder(slug, language?.slug ?? "")]),
);

const isAboutPage = page.canonicalSlug === ABOUT_PAGE_SLUG;
const t = useTranslations(lang);
---

<DefaultLayout
  content={page}
  contentClasses={isAboutPage ? "o-index" : undefined}
  translationsRoutes={translationsRoutes}
>
  {
    isAboutPage ? (
      <Fragment>
        <header class="o-developer-card">
          <div class="o-developer-card__text-wrapper">
            <h1 class="o-developer-card__headline c-post-card">{t("dev_card.headline")}</h1>

            <p class="o-developer-card__text c-post-card">{t("dev_card.header_text")}</p>
          </div>

          <Image
            alt="Felix Scholze portrait"
            class="o-developer-card__image c-post-card"
            height="500"
            layout="constrained"
            priority={true}
            src="https://cms.webshaped.de/wp-content/uploads/felix-scholze_portait_no-background.png"
            width="500"
          />
        </header>

        <GithubStats client:visible lang={lang} />
      </Fragment>
    ) : (
      <div>
        <h1>{page?.title}</h1>
        <article set:html={page.content} />
      </div>
    )
  }
</DefaultLayout>
