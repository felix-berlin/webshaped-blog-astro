---
import "@styles/components/_blocks.scss";
import "@styles/plugins/shiki.scss";

import type { GetStaticPaths } from "astro";

import Blocks from "@components/content-blocks/Blocks.astro";
import BlogPost from "@layouts/BlogPost.astro";
import { tocHeadings } from "@services/fragments/blockFragments";
import { wpQuery } from "@services/wpGraphqlClient";

import { GetAllPostsDocument } from "@/gql/graphql.ts";

export const prerender = true;

export const getStaticPaths = (async () => {
  const postsResponse = await wpQuery(GetAllPostsDocument, { size: 90 });

  // Posts without slugs happen mostly on draft posts
  return (postsResponse.posts?.nodes ?? [])
    .filter((post) => post.slug)
    .map((post) => ({
      params: { lang: post.language?.slug ?? undefined, postSlug: post.slug ?? undefined },
      props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const blocks = post.editorBlocks ?? [];
---

<BlogPost content={post} headings={tocHeadings(blocks)}>
  <Blocks blocks={blocks} />
</BlogPost>
