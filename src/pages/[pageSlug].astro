---
import type { GetStaticPaths, InferGetStaticParamsType, InferGetStaticPropsType } from "astro";

import DefaultLayout from "@layouts/DefaultLayout.astro";
import { wpQuery } from "@services/wpGraphqlClient";

import { useFragment } from "@/gql";
import { GetPagesBySlugsDocument } from "@/gql/graphql.ts";
import { PageFieldFragment } from "@services/queries/getPage";

export const prerender = true;

export const getStaticPaths = (async () => {
  const pagesResponse = await wpQuery(GetPagesBySlugsDocument, {
    slugs: ["datenschutz", "impressum"],
  });

  const pages = pagesResponse.pages?.nodes;

  if (!pages) {
    return [];
  }

  return pages.map((page) => {
    const unmaskedPage = useFragment(PageFieldFragment, page);
    return {
      params: {
        pageSlug: unmaskedPage.slug ?? undefined,
      },
      props: {
        page: unmaskedPage,
      },
    };
  });
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { pageSlug } = Astro.params as Params;
const { page } = Astro.props;
---

<DefaultLayout content={page}>
  <div>
    <h1>{page?.title}</h1>
    <article set:html={page.content} />
  </div>
</DefaultLayout>
