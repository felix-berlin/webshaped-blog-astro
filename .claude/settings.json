{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/warn-unsandboxed-agent.py",
            "timeout": 5,
            "statusMessage": "Checking agent-proxy sandbox status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-plaintext-secrets.py",
            "timeout": 10,
            "statusMessage": "Checking for plaintext secret reads"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-plaintext-secrets.py",
            "timeout": 10,
            "statusMessage": "Checking for plaintext secret reads"
          }
        ]
      }
    ]
  }
}
