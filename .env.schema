# Single source of truth for this project's configuration.
#
# Replaces both `.env.example` and the `envField` schema that used to live in
# `astro.config.mjs`. Values come from Infisical; this file only declares what
# exists, what it must look like, and what may reach the browser.
#
# Read this file freely — it holds no values. That is the point: agents get the
# full schema, humans get the secrets.
#
# @defaultSensitive=true
# @defaultRequired=false
# @currentEnv=$APP_ENV
# @generateTypes(lang='ts', path='env.d.ts')
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=15cc4eb8-b1bc-4e3a-8b83-fba9c17e976a,
#   environment=$APP_ENV,
#   siteUrl=https://infisical.kasimir.dev,
#   identityId=8938f75a-fe73-4688-a8ed-e12dc90e6c0f,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET,
#   cacheTtl="1h"
# )
# ---

# === Infisical access ========================================================
#
# Two auth paths, one schema. Verified 2026-07-31: varlock prefers Universal Auth
# when the client credentials below are set, and falls back to OIDC via
# `identityId` when they are empty. So the same file works in both places:
#
#   CI          → both unset, OIDC against `github-actions-web-shaped`
#                 (needs `permissions: id-token: write` in the workflow)
#   workstation → `.env.local` supplies the pair, Universal Auth against `Local`
#
# There is no OIDC issuer on a laptop, which is why the local path needs the
# credential pair at all. Without `.env.local` you can still prefix any command
# with `infisical run --env=dev --`, because an existing environment variable
# beats the resolver.

# @type=infisicalClientId @sensitive=false
INFISICAL_CLIENT_ID=

# @type=infisicalClientSecret
INFISICAL_CLIENT_SECRET=

# Environment flag. Selects both the Infisical environment and which
# `.env.[env]` file loads. `dev`/`prod` mirror `.infisical.json`'s
# gitBranchToEnvironmentMapping (main/tags → prod, everything else → dev);
# `test` is local-only and resolves entirely from the committed `.env.test`,
# so unit tests never reach Infisical.
# @type=enum(dev, prod, test) @sensitive=false
APP_ENV=dev

# === WordPress ===============================================================

# WPGraphQL endpoint. Also used by the browser-side urql client in
# `src/pages/_app.ts`, so it must stay non-sensitive.
# @required @type=url @sensitive=false
WP_API=infisical()

# WP REST API base, used for comment submission.
# @required @type=url @sensitive=false
WP_REST_API=infisical()

# WordPress core Application Password, sent as HTTP Basic Auth by
# `src/services/wpGraphqlClient.ts`. Required, not optional: a missing credential
# must fail the build rather than prerender empty pages against the
# maintenance-mode holding page.
# @required
WP_AUTH_USER=infisical()

# @required
WP_AUTH_PASS=infisical()

# === Site ====================================================================

# Wrangler Last.fm scrobbler. Read by `Author.vue` in the browser.
# @required @type=url @sensitive=false
LAST_FM_SCROBBLER_API=infisical()

# Site base URL, used by the sitemap.
# @required @type=url @sensitive=false
SITE_URL=infisical()

# @type=boolean @sensitive=false
ENABLE_ANALYTICS=false

# Renders fixture posts instead of live content — build-time only.
# @type=boolean @sensitive=false
SHOW_TEST_DATA=false

# === Third-party services ====================================================

# GitHub API access for `/api/github/stats`.
# @required
GITHUB_TOKEN=infisical()

# @type=url @sensitive=false
SENTRY_DSN=infisical()

# @sensitive=false
SENTRY_PROJECT_ID=infisical()

# @sensitive=false
SENTRY_ENVIRONMENT=infisical()

# Uploads sourcemaps at build time.
SENTRY_AUTH_TOKEN=infisical()

# Coverage upload from CI.
CODECOV_TOKEN=infisical()

# === Local build flags =======================================================
# Not in Infisical — set these in `.env.local` when you need them.

# @type=boolean @sensitive=false
PWA_DEBUG=false

# @type=boolean @sensitive=false
BUNDLE_ANALYZER_OPEN=false
